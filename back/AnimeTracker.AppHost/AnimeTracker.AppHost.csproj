<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

	<ItemGroup>
		<ProjectReference Include="..\AnimeTracker.Web\AnimeTracker.Web.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.0" />
		<PackageReference Include="Aspire.Hosting.Keycloak" Version="13.6.0-preview.1.26479.8" />
		<PackageReference Include="Aspire.Hosting.MongoDB" Version="13.6.0" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>5b1f8c74-2e63-49ad-8f10-6c9d3a274be8</UserSecretsId>
		<!-- Aspire 13.5 warns while DCP and the dashboard still come from NuGet packages rather than the
		     Aspire CLI bundle. Keeping the packages lets `dotnet build` work without the CLI installed. -->
		<NoWarn>$(NoWarn);ASPIRE010</NoWarn>
	</PropertyGroup>

</Project>
